{
	"version": 2,
	"builds": [
		{
			"src": "api/index.js",
			"use": "@vercel/node",
			"config": {
				"includeFiles": ["server/**", "config/**", "static/**", "dist/**", ".babelrc"]
			}
		}
	],
	"routes": [
		{ "src": "/(.*)", "dest": "api/index.js" }
	],
	"functions": {
		"api/index.js": { "maxDuration": 30 }
	}
}
